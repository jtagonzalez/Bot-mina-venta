# Copiá este archivo como ".env" en la carpeta de CADA bot (botmina, anu-venta)
# y completá los valores reales. El .env real NUNCA se sube a git.

# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API → service_role key (secreta — NUNCA la clave "anon" acá,
# y NUNCA pegarla en el dashboard público ni subirla a un repo)
SUPABASE_SERVICE_KEY=

# Identidad de ESTA pc/bot puntual — debe coincidir con un "nombre" ya
# sembrado en la tabla bots (ver supabase_schema.sql): mina-01..mina-08,
# anutrof-01, anutrof-02. Cada PC tiene un valor distinto acá.
BOT_NOMBRE=mina-01
BOT_TIPO=mineria
